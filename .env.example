# --- Asosiy ---
SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit-yozing
DEBUG=False
ALLOWED_HOSTS=portfolio.example.uz
CSRF_TRUSTED_ORIGINS=https://portfolio.example.uz
SITE_URL=https://portfolio.example.uz

# --- PostgreSQL ---
DATABASE_URL=postgres://portfolio_user:STRONG_PASSWORD@localhost:5432/reflective_portfolio
DB_CONN_MAX_AGE=60

# --- Fayllar ---
MEDIA_ROOT=/var/www/reflective_portfolio/media
STATIC_ROOT=/var/www/reflective_portfolio/static
PROTECTED_MEDIA_USE_X_ACCEL=True
# FILE_UPLOAD_TEMP_DIR=/var/tmp/portfolio_uploads

# --- Xavfsizlik ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
USE_X_FORWARDED_FOR=True
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Kesh (bir nechta gunicorn worker uchun umumiy kesh tavsiya etiladi) ---
# CACHE_URL=filecache:///var/tmp/portfolio_cache
# CACHE_URL=rediscache://127.0.0.1:6379/1

# --- Pochta (ixtiyoriy) ---
EMAIL_URL=consolemail://
# EMAIL_URL=smtp+tls://user:password@smtp.example.uz:587
DEFAULT_FROM_EMAIL=noreply@example.uz
NOTIFICATIONS_EMAIL_ENABLED=False

# --- Loglar ---
LOG_DIR=/var/log/reflective_portfolio

# --- Administratorga murojaat (landing va kirish sahifasi) ---
# Telegram havolasi: https://t.me/username  (yoki @username). Bo'sh bo'lsa — havola chiqmaydi.
ADMIN_TELEGRAM_URL=
