# ===== Docker muhiti uchun sozlamalar (docker compose env_file) =====
# Nusxa oling: cp .env.docker.example .env.docker  — va parollarni almashtiring.

# --- PostgreSQL (db konteyneri) ---
POSTGRES_DB=reflective_portfolio
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=ALMASHTIRING_kuchli_parol
DATABASE_URL=postgres://portfolio_user:ALMASHTIRING_kuchli_parol@db:5432/reflective_portfolio

# --- Django ---
SECRET_KEY=ALMASHTIRING_uzun_tasodifiy_kalit
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SITE_URL=http://localhost:8080

# Lokal HTTP sinovi uchun. Domen + HTTPS bo'lsa: True, True, True va SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# --- Fayllar (nginx bilan umumiy volume'lar) ---
MEDIA_ROOT=/app/var/media
STATIC_ROOT=/app/var/static
LOG_DIR=/app/var/logs
FILE_UPLOAD_TEMP_DIR=/app/var/tmp
FILE_UPLOAD_PERMISSIONS=644
PROTECTED_MEDIA_USE_X_ACCEL=True
USE_X_FORWARDED_FOR=True

# Bir nechta gunicorn worker uchun umumiy kesh
CACHE_URL=filecache:///app/var/cache

# --- Birinchi ishga tushirish ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=ALMASHTIRING_admin_paroli
DJANGO_SUPERUSER_EMAIL=admin@example.uz
# 1 — demo ma'lumotlar (fakultet, guruh, ustoz, talabalar, to'liq sikl namunasi). Production'da 0.
SEED_DEMO=0

# --- Pochta (ixtiyoriy) ---
EMAIL_URL=consolemail://
NOTIFICATIONS_EMAIL_ENABLED=False

# --- Zaxira nusxa (backup konteyneri) ---
KEEP_DAYS=14

# --- Administratorga murojaat (landing va kirish sahifasi) ---
# Telegram havolasi: https://t.me/username  (yoki @username). Bo'sh bo'lsa — havola chiqmaydi.
ADMIN_TELEGRAM_URL=
