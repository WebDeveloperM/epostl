# /etc/systemd/system/reflective_portfolio.service
[Unit]
Description=Refleksiv portfolio (gunicorn)
After=network.target postgresql.service

[Service]
User=portfolio
Group=www-data
RuntimeDirectory=reflective_portfolio
WorkingDirectory=/opt/reflective_portfolio
EnvironmentFile=/opt/reflective_portfolio/.env
ExecStart=/opt/reflective_portfolio/.venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/reflective_portfolio/gunicorn.sock \
    --workers 4 --timeout 600 \
    --access-logfile /var/log/reflective_portfolio/access.log \
    --error-logfile /var/log/reflective_portfolio/gunicorn.log
Restart=on-failure

[Install]
WantedBy=multi-user.target
